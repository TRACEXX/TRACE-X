# Copy this file to .env and change the values. .env is never committed (see .gitignore).

# ---- Demo accounts (used only when the database is first created / reset)
TRACEX_ADMIN_USERNAME=admin
TRACEX_ADMIN_PASSWORD=TraceX-Admin-2026
# The four detectives (amna, warisha, hiba, maryam) share this password.
TRACEX_DETECTIVE_PASSWORD=TraceX-Detective-2026

# ---- Flask
# Leave empty to auto-generate a random key in instance/secret_key.txt
TRACEX_SECRET_KEY=
TRACEX_MAX_UPLOAD_MB=200
# Let detectives run the safe integrity demo (temporary copy only). 1 = yes, 0 = admin only.
TRACEX_DEMO_FOR_DETECTIVES=1

# ---- TRACE AI
# none | groq | openrouter | openai | gemini | ollama
# "none" still answers every question from the database, just without an AI-written explanation.
AI_PROVIDER=none
AI_API_KEY=
# Optional: override the provider's default model
AI_MODEL=
# Optional: custom OpenAI-compatible endpoint (e.g. a university proxy)
AI_BASE_URL=
# Ollama (local, nothing leaves the computer)
OLLAMA_URL=http://localhost:11434
AI_TIMEOUT=45
